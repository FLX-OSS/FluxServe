ARG CUDA_VERSION=13.0.2
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu24.04

LABEL org.opencontainers.image.authors="Youpeng Zhao" \
      org.opencontainers.image.description="FluxServe and Foundry development image with CUDA 13.0 userspace"

ARG PYTORCH_VERSION=2.11.0
ARG TORCHVISION_VERSION=0.26.0
ARG TORCHAUDIO_VERSION=2.11.0

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/New_York \
    CUDA_HOME=/usr/local/cuda \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:${PATH} \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST=9.0 \
    MAX_JOBS=64 \
    FLASHINFER_WORKSPACE_BASE=/tmp \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64

RUN set -eux; \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime; \
    echo "${TZ}" > /etc/timezone; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        git-lfs \
        libboost-filesystem1.83-dev \
        libboost-json1.83-dev \
        libssl-dev \
        ninja-build \
        pkg-config \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget; \
    python3.12 -m venv "${VIRTUAL_ENV}"; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    python -m pip install --no-cache-dir --upgrade \
        pip==26.1.2 \
        setuptools==83.0.0 \
        wheel==0.47.0 \
        "cmake>=4.0" \
        ninja==1.13.0; \
    python -m pip install --no-cache-dir \
        "torch==${PYTORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        "torchaudio==${TORCHAUDIO_VERSION}" \
        --index-url https://download.pytorch.org/whl/cu130

# Install FluxServe's non-Torch dependencies explicitly so its cu129 pins cannot
# replace the Foundry-compatible Torch/CUDA stack.
RUN set -eux; \
    python -m pip install --no-cache-dir \
        aiohttp==3.13.0 \
        apache-tvm-ffi==0.1.12 \
        fastapi==0.118.2 \
        huggingface-hub==0.35.3 \
        "nanobind>=1.7.0" \
        numpy==2.3.3 \
        nvidia-cutlass-dsl==4.6.0 \
        nvidia-ml-py==13.580.82 \
        packaging==25.0 \
        pyzmq==27.1.0 \
        safetensors==0.6.2 \
        scikit-build-core==0.11.6 \
        setproctitle==1.3.7 \
        sgl-kernel==0.3.15 \
        tokenizers==0.22.1 \
        transformers==4.57.0 \
        uvicorn==0.37.0; \
    python -m pip uninstall -y pynvml flashinfer-python || true

RUN set -eux; \
    git clone --recursive https://github.com/kennethzhao24/flashinfer-dllm \
        -b feature/block-extend \
        /flashinfer-dllm-workspace/flashinfer-dllm; \
    cd /flashinfer-dllm-workspace/flashinfer-dllm; \
    git checkout 631231b2d8a6b7a1d59dfcc9be13b81df30a3416; \
    git submodule update --init --recursive; \
    python -m pip install --no-cache-dir --no-build-isolation -v .

WORKDIR /workspace
CMD ["/bin/bash", "--login"]
