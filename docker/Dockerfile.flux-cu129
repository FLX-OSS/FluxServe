FROM lmsysorg/sglang:v0.5.3.post1

LABEL org.opencontainers.image.authors="Youpeng Zhao" \
      org.opencontainers.image.description="FluxServe image with CUDA 12.9 userspace"

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=9.0 \
    MAX_JOBS=64 \
    FLASHINFER_WORKSPACE_BASE=/tmp \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64

RUN set -eux; \
    mkdir -p /flashinfer-dllm-workspace; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        ccache \
        cmake \
        curl \
        dnsutils \
        git \
        git-lfs \
        libibverbs-dev \
        libibverbs1 \
        libnuma-dev \
        libnuma1 \
        libopenmpi-dev \
        libssl-dev \
        ninja-build \
        nvtop \
        openssh-server \
        patchelf \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        rsync \
        software-properties-common \
        wget; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    python -m pip install \
        "apache-tvm-ffi>=0.1.6,!=0.1.8,!=0.1.8.post0,<0.2" \
        "nvidia-cutlass-dsl>=4.5.0"; \
    python -m pip uninstall -y pynvml; \
    python -m pip install nvidia-ml-py; \
    python -m pip uninstall -y flashinfer-python

RUN set -eux; \
    git clone --recursive https://github.com/kennethzhao24/flashinfer-dllm \
        -b feature/block-extend \
        /flashinfer-dllm-workspace/flashinfer-dllm; \
    cd /flashinfer-dllm-workspace/flashinfer-dllm; \
    git submodule update --init --recursive; \
    python -m pip install -v .; \
    rm -rf /root/.cache/pip

CMD ["/bin/bash", "--login"]
