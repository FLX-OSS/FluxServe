ARG CUDA_VERSION=12.9.1
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu22.04

LABEL org.opencontainers.image.authors="Youpeng Zhao" \
      org.opencontainers.image.description="FluxServe image with CUDA 12.9 userspace"

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/New_York \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=9.0 \
    MAX_JOBS=64 \
    FLASHINFER_WORKSPACE_BASE=/tmp \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64

RUN set -eux; \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime; \
    echo "${TZ}" > /etc/timezone; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        software-properties-common \
        wget; \
    add-apt-repository ppa:deadsnakes/ppa -y; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        python3.12-full \
        python3.12-dev \
        python3.10-venv; \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1; \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 2; \
    update-alternatives --set python3 /usr/bin/python3.12; \
    ln -sf /usr/bin/python3.12 /usr/bin/python; \
    wget https://bootstrap.pypa.io/get-pip.py; \
    python3 get-pip.py; \
    rm -f get-pip.py; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p /flashinfer-dllm-workspace; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bear \
        build-essential \
        ccache \
        check \
        cloc \
        cmake \
        curl \
        debhelper \
        devscripts \
        dkms \
        dnsutils \
        fakeroot \
        gdb \
        git \
        git-lfs \
        htop \
        ibverbs-providers \
        infiniband-diags \
        kmod \
        less \
        libboost-all-dev \
        libcurl4-openssl-dev \
        libczmq-dev \
        libczmq4 \
        libfabric-dev \
        libgoogle-glog-dev \
        libgrpc++-dev \
        libgrpc-dev \
        libgtest-dev \
        libhiredis-dev \
        libibumad3 \
        libibverbs-dev \
        libibverbs1 \
        libjsoncpp-dev \
        libnl-3-200 \
        libnl-3-dev \
        libnl-route-3-200 \
        libnl-route-3-dev \
        libnuma-dev \
        libnuma1 \
        libopenmpi-dev \
        librdmacm1 \
        libssl-dev \
        libsubunit-dev \
        libsubunit0 \
        libunwind-dev \
        locales \
        lsof \
        netcat-openbsd \
        ninja-build \
        nvtop \
        openssh-server \
        patchelf \
        perftest \
        pkg-config \
        protobuf-compiler \
        protobuf-compiler-grpc \
        pybind11-dev \
        rdma-core \
        rsync \
        silversearcher-ag \
        tmux \
        tree \
        unzip \
        vim \
        wget \
        zsh; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get clean

RUN set -eux; \
    python -m pip install --upgrade \
        pip==26.1.2 \
        setuptools==83.0.0 \
        wheel==0.47.0; \
    python -m pip install \
        torch==2.8.0 \
        torchvision==0.23.0 \
        torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu129

RUN set -eux; \
    python -m pip install \
        triton==3.4.0 \
        transformers==4.57.0 \
        tokenizers==0.22.1 \
        safetensors==0.6.2 \
        huggingface-hub==0.35.3 \
        numpy==2.3.3 \
        aiohttp==3.13.0 \
        fastapi==0.118.2 \
        uvicorn==0.37.0 \
        pyzmq==27.1.0 \
        packaging==25.0 \
        setproctitle==1.3.7 \
        scikit-build-core==0.11.6 \
        "nanobind>=1.7.0" \
        ninja==1.13.0 \
        nvidia-ml-py==13.580.82 \
        apache-tvm-ffi==0.1.12 \
        nvidia-cutlass-dsl==4.6.0 \
        sgl-kernel==0.3.15; \
    python -m pip uninstall -y pynvml || true; \
    python -m pip uninstall -y flashinfer-python || true

RUN set -eux; \
    git clone --recursive https://github.com/kennethzhao24/flashinfer-dllm \
        -b feature/block-extend \
        /flashinfer-dllm-workspace/flashinfer-dllm; \
    cd /flashinfer-dllm-workspace/flashinfer-dllm; \
    git submodule update --init --recursive; \
    python -m pip install -v .; \
    rm -rf /root/.cache/pip

CMD ["/bin/bash", "--login"]
